{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // The Node test runner (npm test) loads *.test.ts files with explicit
    // `.ts` extensions, which requires this flag (safe because noEmit is on).
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // The optional Cloudflare adapter config (open-next.config.ts) is only
    // consumed by `npx opennextjs-cloudflare build` and imports
    // `@opennextjs/cloudflare`, which is NOT a project dependency — buyers
    // install it only when deploying to Cloudflare (see DEPLOY-CLOUDFLARE.md).
    // Excluding it keeps the standard `npm run typecheck` green for the
    // Vercel / Netlify / plain-Node deploys; the OpenNext build still loads
    // and bundles it with the adapter installed.
    "open-next.config.ts",
    // The multi-tenant platform (Supabase + Cloudflare Workers/KV) is a
    // self-contained sibling workspace with its OWN tsconfig, deps and tests
    // (see multi-tenant-platform/README.md). Its optional packages
    // (@supabase/supabase-js, @cloudflare/workers-types) are NOT storefront
    // dependencies, so it is excluded from the storefront typecheck.
    "multi-tenant-platform"
  ]
}
