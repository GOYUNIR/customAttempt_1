{
  // ═══════════════════════════════════════════════════════════════════════════
  // Cloudflare Workers config for the MAIN storefront app (OpenNext build).
  // Used ONLY when deploying to Cloudflare — see DEPLOY-CLOUDFLARE.md.
  //
  // `npx opennextjs-cloudflare build` outputs:
  //   .open-next/worker.js  → the whole Next.js app (routes, middleware, /og,
  //                           /icon, /media) as a single Worker
  //   .open-next/assets     → static assets, served by the ASSETS binding
  //
  // ── ENVIRONMENT VARIABLES — the COMPLETE reference ─────────────────────────
  // This covers EVERY variable this store can read. They live in the Cloudflare
  // dashboard under "Runtime variables and secrets":
  //   Workers & Pages → [project] → Settings → Variables and Secrets → Production
  //
  // Legend:
  //   [REQUIRED]     the app breaks without it (payments / raffles / admin)
  //   [RECOMMENDED]  works without it, but set it for production
  //   [OPTIONAL]     only needed for a specific feature
  //   [SETUP WIZARD] enter it on the site at /admin/setup — the wizard SAVES a
  //                  copy AND shows the exact `npx wrangler secret put` command.
  //                  (step 1 data store · step 3 core services · step 4 security
  //                  & identity · step 5 AI engine)
  //
  // WHERE to set each value:
  //   (NECESSARY HERE)  put it in THIS file / the Cloudflare dashboard (or your
  //                     BUILD SHELL for NEXT_PUBLIC_*). The server reads it from
  //                     the environment directly, so the site cannot stand in
  //                     for it.
  //   (USE SITE)        set it on the site instead (admin portal, or the
  //                     /admin/setup wizard). For these, the environment is only
  //                     an optional fallback.
  //
  // Every entry is annotated with its necessity + a REALISTIC EXAMPLE VALUE
  // (e.g. pk.eyJ…, sk_live_…, you@example.com) so you can see exactly what to
  // paste. The examples are never real keys — always swap in your own.
  //
  // ── How secrets vs plaintext vars work on Cloudflare ───────────────────────
  //   • Plaintext (non-secret) variables → the `vars` block at the bottom. The
  //     first `wrangler deploy` auto-creates them as editable "Variables" in the
  //     dashboard. ONLY these appear automatically — the dashboard will NOT list
  //     the secrets below until you add them yourself.
  //   • SECRETS → the dashboard "Secrets" column, or `npx wrangler secret put
  //     NAME`. NEVER commit a real secret in this file. See DEPLOY-CLOUDFLARE.md
  //     Step 3 for the full copy-paste list.
  //   • BUILD-TIME (NEXT_PUBLIC_*) → in your shell BEFORE `npm run build:cloudflare`
  //     (Step 2). They can NOT be set in the dashboard at all.
  // ═══════════════════════════════════════════════════════════════════════════
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storefront-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // ── PLAINTEXT (non-secret) RUNTIME variables ───────────────────────────────
  // Auto-created as editable "Variables" on the first deploy. These are the only
  // values safe to keep as plaintext (they are not credentials).
  "vars": {
    // [OPTIONAL] force a data store. One of: "supabase" (default) | "upstash" |
    //   "cloudflare-kv". (NECESSARY HERE — only if you override the default)
    //   Example: "supabase"                              (SETUP WIZARD step 1)
    "STORAGE_PROVIDER": "supabase",

    // [RECOMMENDED] the ADMIN EMAIL — this is the email you sign into /admin
    //   with (there is NO separate "username" anymore) and the inbox that
    //   receives the 6-digit /admin two-step code. (NECESSARY HERE)
    //   Example: "you@example.com"                       (SETUP WIZARD step 4)
    "ADMIN_VERIFY_EMAIL": "",

    // [OPTIONAL] brand name used in emails + templates. (USE SITE)
    //   Prefer /admin → Settings → Branding & Share (brandName) — this env is
    //   only a fallback.  Example: "Acme"                 (SETUP WIZARD step 4)
    "BRAND_NAME": "",

    // [OPTIONAL] support inbox shown in the footer + used for customer emails.
    //   (USE SITE) Prefer /admin → Settings → Footer — this env is only a
    //   fallback.  Example: "help@example.com"            (SETUP WIZARD step 4)
    "SUPPORT_EMAIL": "",

    // [OPTIONAL] "true" shows the maintenance screen to unauthenticated
    //   visitors. (NECESSARY HERE)
    //   Example: "true" (or empty = off)
    "MAINTENANCE_MODE": "",

    // [OPTIONAL] the "from" address for transactional emails when the email
    //   provider needs one. (NECESSARY HERE — only if the site doesn't set it)
    //   Example: "Acme <onboarding@resend.dev>"          (SETUP WIZARD step 3)
    "RESEND_FROM": "",

    // [OPTIONAL] "true" turns ON license enforcement (blocks writes when the
    //   license key is missing or expired). (NECESSARY HERE)
    //   Example: "true" (or empty = off)
    "LICENSE_ENFORCED": ""
  }
  //
  // ── SECRETS — set in the dashboard ("Secrets" column) or via: ──────────────
  //   npx wrangler secret put NAME
  // (Never paste these into the `vars` block above.)
  //
  // ── DATA STORE (one backend required — Supabase is the default) ────────────
  //   SUPABASE_URL               [REQUIRED for Supabase]  "https://abcdefgh.supabase.co"  (NECESSARY HERE) (SETUP WIZARD step 1)
  //   SUPABASE_ANON_KEY          [REQUIRED for Supabase]  "eyJhbGciOiJIUzI1NiIs…"          (NECESSARY HERE) (SETUP WIZARD step 1)
  //   SUPABASE_SERVICE_ROLE_KEY  [REQUIRED for Supabase]  "eyJhbGciOiJIUzI1NiIs…" (server-only) (NECESSARY HERE) (SETUP WIZARD step 1)
  //   UPSTASH_REDIS_REST_URL     [OPTIONAL alt store]     "https://fast-swan-12345.upstash.io" (NECESSARY HERE) (SETUP WIZARD step 1)
  //   UPSTASH_REDIS_REST_TOKEN   [OPTIONAL alt store]     "AX3rASFh…"             (NECESSARY HERE) (SETUP WIZARD step 1)
  //
  // ── ADMIN ──────────────────────────────────────────────────────────────────
  //   ADMIN_BASIC_AUTH_PASSWORD  [RECOMMENDED] the /admin HTTP Basic Auth password.
  //     Only needed if you don't use the master admin account (email + password)
  //     created by the Setup Wizard. (NECESSARY HERE)
  //     Example: "a-long-random-password"                  (SETUP WIZARD step 4)
  //   (There is NO ADMIN_BASIC_AUTH_USERNAME — you sign in with your EMAIL, i.e.
  //    ADMIN_VERIFY_EMAIL above.)
  //
  // ── PAYMENTS ───────────────────────────────────────────────────────────────
  //   STRIPE_SECRET_KEY          [REQUIRED for payments]  "sk_live_51AbCdEf…"    (USE SITE) (SETUP WIZARD step 3)
  //   STRIPE_WEBHOOK_SECRET      [REQUIRED for payments]  "whsec_AbCdEf…"        (USE SITE) (SETUP WIZARD step 3)
  //   STRIPE_PRODUCT_ID          [OPTIONAL] default price "price_1AbCdEf…"       (USE SITE) (SETUP WIZARD step 3)
  //   LEMONSQUEEZY_API_KEY       [OPTIONAL alt payments]  "eyJ0eXAiOiJKV1Qi…"    (USE SITE) (SETUP WIZARD step 3)
  //   LEMONSQUEEZY_STORE_ID      [OPTIONAL alt payments]  "12345"                (USE SITE) (SETUP WIZARD step 3)
  //   LEMONSQUEEZY_VARIANT_ID    [OPTIONAL alt payments]  "67890"                (USE SITE) (SETUP WIZARD step 3)
  //   PADDLE_API_KEY             [OPTIONAL alt payments]  "pdl_live_AbCdEf…"     (USE SITE) (SETUP WIZARD step 3)
  //
  // ── EMAIL ──────────────────────────────────────────────────────────────────
  //   RESEND_API_KEY             [REQUIRED for email]     "re_AbCdEfG…"          (USE SITE) (SETUP WIZARD step 3)
  //   RESEND_FROM                [RECOMMENDED]            "Acme <onboarding@resend.dev>" (NECESSARY HERE) (SETUP WIZARD step 3)
  //   EMAIL_FROM                 [OPTIONAL alias]         same as RESEND_FROM above (takes priority when both set)
  //   POSTMARK_API_KEY           [OPTIONAL alt email]     "9f4a2c1e…"            (USE SITE) (SETUP WIZARD step 3)
  //   SENDGRID_API_KEY           [OPTIONAL alt email]     "SG.AbCdEfG…"          (USE SITE) (SETUP WIZARD step 3)
  //
  // ── CRON SAFETY NET ────────────────────────────────────────────────────────
  //   CRON_SECRET                [RECOMMENDED]            "a-long-random-string" (NECESSARY HERE) (SETUP WIZARD step 4)
  //
  // ── AI ENGINE ──────────────────────────────────────────────────────────────
  //   DEEPSEEK_API_KEY           [RECOMMENDED primary]    "sk-abcd…"             (USE SITE) (SETUP WIZARD step 5)
  //   OPENAI_API_KEY             [OPTIONAL]               "sk-proj-…"            (USE SITE) (SETUP WIZARD step 5)
  //   ANTHROPIC_API_KEY          [OPTIONAL]               "sk-ant-api03-…"       (USE SITE) (SETUP WIZARD step 5)
  //   REPLICATE_API_TOKEN        [OPTIONAL]               "r8_AbCdEf…"           (USE SITE) (SETUP WIZARD step 5)
  //   OPENROUTER_API_KEY         [OPTIONAL]               "sk-or-v1-…"           (USE SITE) (SETUP WIZARD step 5)
  //   GROQ_API_KEY               [OPTIONAL]               "gsk_AbCdEf…"          (USE SITE) (SETUP WIZARD step 5)
  //   MISTRAL_API_KEY            [OPTIONAL]               "AbCdEfGh…"            (USE SITE) (SETUP WIZARD step 5)
  //   GEMINI_API_KEY             [OPTIONAL]               "AIzaSy…"              (USE SITE) (SETUP WIZARD step 5)  (NOT "GOOGLE_GEMINI_API_KEY")
  //   (Workers AI needs NO key — it uses the native Cloudflare `AI` binding.)
  //
  // ── LICENSING (optional) ───────────────────────────────────────────────────
  //   CLIENT_LICENSE_KEY         [OPTIONAL]               "LIC-…"   (alias: LICENSE_KEY) (NECESSARY HERE)
  //   LICENSE_SERVER_URL         [OPTIONAL]               "https://license.example.com/check" (NECESSARY HERE)
  //   LICENSE_ENFORCED           [OPTIONAL]               "true"                  (NECESSARY HERE)
  //
  // ── BUILD-TIME (NOT runtime) — these are INLINED at build time and MUST be in
  //   your SHELL when you run `npm run build:cloudflare`. They can NOT be set in
  //   the Cloudflare dashboard:
  //   NEXT_PUBLIC_URL            [RECOMMENDED]            "https://yourdomain.com"  (NECESSARY HERE — build shell)
  //   NEXT_PUBLIC_SITE_NAME      [OPTIONAL]               "Acme"     (alias: BRAND_NAME) (USE SITE)
  //   NEXT_PUBLIC_MAPBOX_TOKEN   [OPTIONAL maps]          "pk.eyJ1Ijoi…"          (NECESSARY HERE — build shell) (SETUP WIZARD step 3)
  //   GOOGLE_MAPS_API_KEY        [OPTIONAL alt maps]      "AIzaSy…"               (NECESSARY HERE — build shell) (SETUP WIZARD step 3)
  //   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY  [alias of the above]
  //
  // ── LOCAL DEVELOPMENT ONLY (never set in production) ────────────────────────
  //   DEV_WEBHOOK_BYPASS         [DEV ONLY]               "1"                     (NECESSARY HERE — dev; lets /api/stripe/webhook accept unsigned events in non-production)
}
