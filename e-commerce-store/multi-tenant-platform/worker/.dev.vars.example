# Copy to `.dev.vars` (gitignored) and fill in real values for local `wrangler dev`.
# NEVER commit real secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Same value you will `wrangler secret put FLUSH_CACHE_SECRET` in production.
FLUSH_CACHE_SECRET=local-dev-flush-secret
