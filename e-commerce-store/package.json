{
  "name": "e-commerce-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/inject-mapbox-token.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.ts tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "node scripts/inject-mapbox-token.mjs && npx opennextjs-cloudflare build",
    "deploy:cf": "npm run build:cloudflare && npx wrangler deploy",
    "migrate:backfill": "tsx scripts/migrate-redis-to-supabase.ts",
    "check:production-readiness": "tsx scripts/production-readiness-check.ts",
    "simulate:concurrency": "tsx scripts/simulate-concurrency.ts",
    "verify:idempotency": "tsx scripts/verify-idempotency-replay.ts",
    "verify:db-timeouts": "tsx scripts/verify-db-timeouts.ts",
    "verify:cloudflare-sync": "tsx scripts/verify-cloudflare-domain-sync.ts",
    "dryrun:raffle": "tsx scripts/dry-run-raffle-draw.ts",
    "verify:notifications": "tsx scripts/verify-notification-recovery.ts",
    "verify:catalog": "tsx scripts/verify-catalog-roundtrip.ts",
    "verify:storage": "tsx scripts/verify-storage-failclosed.ts",
    "verify:r2": "tsx scripts/verify-r2-roundtrip.ts",
    "verify:parity": "tsx scripts/verify-loadproducts-parity.ts",
    "verify:inventory": "tsx scripts/verify-inventory-decrement.ts",
    "verify:lock": "tsx scripts/verify-lock-mutual-exclusion.ts",
    "verify:entries": "tsx scripts/verify-raffle-entries.ts",
    "verify:draw-charging": "tsx scripts/verify-draw-charging-stripe.ts",
    "verify:profile": "tsx scripts/verify-customer-profile.ts",
    "verify:profile-roundtrip": "tsx scripts/verify-profile-roundtrip.ts",
    "backfill:profiles": "tsx scripts/backfill-customer-profiles.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@upstash/redis": "^1.34.3",
    "csstype": "^3.2.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^4.8.0",
    "stripe": "^22.3.2",
    "wrangler": "^4.124.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
