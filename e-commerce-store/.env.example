# ============================================================================
# .env.example — COMPLETE environment-variable template for this storefront.
#
# This is the ONE universal template for Vercel, Netlify, a plain Node host,
# and local development. Copy it and fill in your real values:
#
#   Local dev / Node host ......... copy to `.env.local`
#   Vercel ...................... add each var in Project → Settings →
#                                 Environment Variables (Production + Preview)
#   Netlify ..................... add each var in Site → Environment variables
#   Cloudflare (Workers) ........ use `.dev.vars.example` (local) + the
#                                 `wrangler.jsonc` reference; deploy with
#                                 DEPLOY-CLOUDFLARE.md
#
# ⚠ NEVER commit real secrets. The values below are REALISTIC EXAMPLES ONLY —
#    every one is a fake/placeholder you must replace with your own.
#
# ── HOW TO READ EACH LINE ────────────────────────────────────────────────────
#   [REQUIRED]     the app breaks without it (payments / raffles / admin)
#   [RECOMMENDED]  works without it, but set it for production
#   [OPTIONAL]     only needed for a specific feature
#
#   (NECESSARY HERE)  the SERVER reads it straight from the environment, so it
#                     MUST be set here / in the hosting platform. The site
#                     cannot stand in for it.
#   (USE SITE)        set it on the SITE instead (admin portal, or the
#                     /admin/setup wizard). The environment is only a fallback.
#
#   (BUILD-TIME)      a NEXT_PUBLIC_* var — inlined into the JS bundle at build
#                     time. You MUST set it before building AND redeploy. It
#                     can NOT be changed later in the dashboard.
# ============================================================================


# ════════════════════════════════════════════════════════════════════════════
# 1. DATA STORE  (pick ONE backend — Supabase is the default)
# ════════════════════════════════════════════════════════════════════════════

# (NECESSARY HERE) Force a backend. One of: supabase | upstash | cloudflare-kv | d1
# Leave UNSET to auto-detect (Supabase first, then Cloudflare KV/D1 bindings,
# then Upstash Redis). Active provider shows in /admin → SetUp.
STORAGE_PROVIDER=supabase

# ── Option A: Supabase (DEFAULT — Postgres + Auth + config) ──────────────────
# (NECESSARY HERE) Project URL. Supabase → Project Settings → API → Project URL.
SUPABASE_URL=https://abcdefghijklm.supabase.co
# (NECESSARY HERE) Public anon key (safe to expose client-side).
# Alias accepted: NEXT_PUBLIC_SUPABASE_URL
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# (NECESSARY HERE) SERVICE ROLE key — server-only, bypasses RLS. NEVER expose it.
# Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# (OPTIONAL — auto "Fix the schema for me") Supabase personal access token so the
# Setup Wizard can apply the migrations through the Management API in one click.
# Create a NEW token at https://supabase.com/dashboard/account/tokens (tokens
# start with `sbp_`). If an old/legacy token is rejected, delete it and make a
# new one. Keep this server-side only — never expose it client-side.
SUPABASE_ACCESS_TOKEN=sbp_...new-personal-access-token...

# ── Option B: Upstash Redis (REST pair) ─────────────────────────────────────
# (NECESSARY HERE — only if you use Redis) Upstash → your DB → REST API.
# Aliases accepted: KV_REST_API_URL, REDIS_REST_URL, REDIS_URL, KV_URL
# (wire-protocol redis:// URLs are skipped automatically — use the https REST URL)
UPSTASH_REDIS_REST_URL=https://eu1-brave-falcon-12345.upstash.io
# (NECESSARY HERE — only if you use Redis)
# Aliases accepted: KV_REST_API_TOKEN, REDIS_REST_TOKEN, REDIS_TOKEN
UPSTASH_REDIS_REST_TOKEN=AX3rASFh...

# ── Option C: Cloudflare KV / D1 ─────────────────────────────────────────────
# No env keys needed — set STORAGE_PROVIDER=cloudflare-kv (or d1) and provide
# a KV/D1 binding (see wrangler.jsonc / DEPLOY-CLOUDFLARE.md). On Workers the
# adapter auto-detects a KV/D1-shaped global binding.

# ════════════════════════════════════════════════════════════════════════════
# 2. ADMIN PORTAL  (email + password sign-in)
# ════════════════════════════════════════════════════════════════════════════

# (NECESSARY HERE) [RECOMMENDED] The admin EMAIL — this is the email you sign
# into /admin with (the Basic Auth "username" is this email; there is NO
# separate username) AND the inbox that receives the 6-digit /admin two-step
# code. Falls back to SUPPORT_EMAIL / REPLY_TO_EMAIL.
ADMIN_VERIFY_EMAIL=you@example.com

# (NECESSARY HERE) [RECOMMENDED] The /admin HTTP Basic Auth password. Only
# needed if you are NOT using the master admin account (email + password)
# created by the /admin/setup Setup Wizard.
ADMIN_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password


# ════════════════════════════════════════════════════════════════════════════
# 3. PAYMENTS
# ════════════════════════════════════════════════════════════════════════════

# ── Stripe (default — keeps raffle card-save + webhooks) ────────────────────
# (USE SITE) [REQUIRED for payments] /admin/setup wizard step 3 — env is only a fallback.
STRIPE_SECRET_KEY=sk_live_51AbCdEf...
# (USE SITE) [REQUIRED for payments] Webhook signing secret (Stripe → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_AbCdEf...
# (USE SITE) [OPTIONAL] Global default Stripe PRICE id; per-product IDs in admin always win.
STRIPE_PRODUCT_ID=price_1AbCdEf...

# ── Lemon Squeezy (alternative payment provider) ─────────────────────────────
# (USE SITE) [OPTIONAL] Lemon Squeezy → Settings → API → API key (a JWT starting "eyJ…").
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...
# (USE SITE) [OPTIONAL] Numeric Lemon Squeezy store id (if not passed inline).
LEMONSQUEEZY_STORE_ID=12345
# (USE SITE) [OPTIONAL] Lemon Squeezy checkout variant id (custom_price).
LEMONSQUEEZY_VARIANT_ID=67890

# ── Paddle (alternative payment provider) ────────────────────────────────────
# (USE SITE) [OPTIONAL] Paddle → Developer tools → API keys.
PADDLE_API_KEY=pdl_live_AbCdEf...

# ════════════════════════════════════════════════════════════════════════════
# 4. EMAIL  (transactional — confirmations, winners, 2FA codes, resets)
# ════════════════════════════════════════════════════════════════════════════

# ── Resend (default) ─────────────────────────────────────────────────────────
# (USE SITE) [REQUIRED for email] Resend → API Keys.
RESEND_API_KEY=re_AbCdEfG...
# (NECESSARY HERE) [RECOMMENDED] The "from" address for outgoing email.
# Alias: EMAIL_FROM (takes priority when both are set).
RESEND_FROM=Acme <onboarding@resend.dev>

# ── Postmark (alternative email provider) ────────────────────────────────────
# (USE SITE) [OPTIONAL] Postmark → Servers → API Tokens.
POSTMARK_API_KEY=9f4a2c1e-...

# ── SendGrid (alternative email provider) ────────────────────────────────────
# (USE SITE) [OPTIONAL] SendGrid → Settings → API Keys.
SENDGRID_API_KEY=SG.AbCdEfG...


# ════════════════════════════════════════════════════════════════════════════
# 5. MAPS  (address autofill at checkout)
# ════════════════════════════════════════════════════════════════════════════

# ── Mapbox (default) ─────────────────────────────────────────────────────────
# (NECESSARY HERE — BUILD-TIME) [OPTIONAL] Public pk.* token. Without it
# customers type addresses manually. Set it in the SAME environment as the
# deploy, then REDEPLOY (it is inlined at build time).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ── Google Maps (alternative) ────────────────────────────────────────────────
# (NECESSARY HERE — BUILD-TIME) [OPTIONAL] Google Cloud Console → APIs &
# Services → Credentials → API key (starts "AIza…").
# Alias accepted: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=AIzaSy...

# ════════════════════════════════════════════════════════════════════════════
# 6. CRON SAFETY NET
# ════════════════════════════════════════════════════════════════════════════

# (NECESSARY HERE) [RECOMMENDED] Authenticates the scheduled draw safety net
# (/api/checkout/cron-draw, /api/cron/*). Schedulers call with
# `Authorization: Bearer $CRON_SECRET`. Generate any long random string.
CRON_SECRET=replace-with-a-long-random-string


# ════════════════════════════════════════════════════════════════════════════
# 7. SITE IDENTITY
# ════════════════════════════════════════════════════════════════════════════

# (NECESSARY HERE — BUILD-TIME) [RECOMMENDED] Canonical domain for links, social
# cards and emails. Aliases accepted: NEXT_PUBLIC_SITE_URL, SITE_URL. If none
# are set, platform system vars are used automatically:
#   Vercel (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL),
#   Netlify (URL / DEPLOY_URL),
#   Cloudflare Pages (CF_PAGES_URL).
NEXT_PUBLIC_URL=https://www.yourstore.com

# (USE SITE) [OPTIONAL] Brand name shown in emails. The storefront brand itself
# is set in /admin → Settings → Branding & Share (brandName). Alias: NEXT_PUBLIC_SITE_NAME.
BRAND_NAME=Acme

# (USE SITE) [OPTIONAL] Support inbox in the footer + customer emails.
# Set per-buyer in /admin → Settings → Footer / Legal & Policies. Alias: REPLY_TO_EMAIL.
SUPPORT_EMAIL=help@example.com

# ════════════════════════════════════════════════════════════════════════════
# 8. AI ENGINE  (image-to-animation + dynamic SVG — OPTIONAL)
# ════════════════════════════════════════════════════════════════════════════
# Primary provider is DeepSeek by default; the rest are optional fallbacks.
# Set these on the SITE at /admin/setup wizard step 5 — env is only a fallback.

# (USE SITE) [RECOMMENDED primary]
DEEPSEEK_API_KEY=sk-abcd...
# (USE SITE) [OPTIONAL]
OPENAI_API_KEY=sk-proj-...
# (USE SITE) [OPTIONAL]
ANTHROPIC_API_KEY=sk-ant-api03-...
# (USE SITE) [OPTIONAL]
REPLICATE_API_TOKEN=r8_AbCdEf...
# (USE SITE) [OPTIONAL]
OPENROUTER_API_KEY=sk-or-v1-...
# (USE SITE) [OPTIONAL]
GROQ_API_KEY=gsk_AbCdEf...
# (USE SITE) [OPTIONAL]
MISTRAL_API_KEY=AbCdEfGh...
# (USE SITE) [OPTIONAL] Google Gemini — the variable name is GEMINI_API_KEY
# (NOT GOOGLE_GEMINI_API_KEY). Google AI Studio → Get API key (starts "AIza…").
GEMINI_API_KEY=AIzaSy...
# (Cloudflare Workers AI needs NO key — it uses the native `AI` binding.)


# ════════════════════════════════════════════════════════════════════════════
# 9. LICENSING  (OPTIONAL — enforced only when a key/server is configured)
# ════════════════════════════════════════════════════════════════════════════

# (NECESSARY HERE) [OPTIONAL] Your license key. Alias: LICENSE_KEY
CLIENT_LICENSE_KEY=LIC-1234-ABCD-5678-EFGH
# (NECESSARY HERE) [OPTIONAL] License server that validates the key.
LICENSE_SERVER_URL=https://license.example.com/check
# (NECESSARY HERE) [OPTIONAL] "true" turns ON enforcement (blocks writes when the
# license key is missing or expired). Empty = off.
LICENSE_ENFORCED=


# ════════════════════════════════════════════════════════════════════════════
# 10. OPERATIONS
# ════════════════════════════════════════════════════════════════════════════

# (NECESSARY HERE) [OPTIONAL] "true" shows the maintenance screen to
# unauthenticated visitors. Empty = off.
MAINTENANCE_MODE=


# ════════════════════════════════════════════════════════════════════════════
# 11. LOCAL DEVELOPMENT ONLY  (never set these in production)
# ════════════════════════════════════════════════════════════════════════════

# (NECESSARY HERE — DEV ONLY) "1" lets /api/stripe/webhook accept unsigned
# events in non-production (for testing with `stripe listen --forward-to`).
# Production ALWAYS requires a valid STRIPE_WEBHOOK_SECRET signature.
DEV_WEBHOOK_BYPASS=




